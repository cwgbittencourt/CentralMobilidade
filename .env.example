# Copy to an untracked root .env and supply distinct local secrets before starting Compose.
# Empty values are intentional: this file contains no working credentials.
POSTGRES_PASSWORD=
RABBITMQ_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
GRAFANA_ADMIN_USER=admin
INFLUXDB_GRAFANA_READ_TOKEN=

# Absolute path to the offline InfluxDB admin token JSON file (see deploy/README.md).
# Keep the file private and reuse it with its existing catalog.
INFLUXDB_QUERYABLE_ADMIN_TOKEN_FILE=

# Loopback ports for the base Grafana service and development override.
GRAFANA_PORT=3000
POSTGRES_PORT=5432
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
INFLUXDB_QUERYABLE_PORT=8181
PROMETHEUS_PORT=9090
LOKI_PORT=3100
API_PORT=8080
PUBSUB_EMULATOR_PORT=8085
PUBSUB_PROJECT_ID=centralmobilidade-local

# .NET configuration examples: export these in the application process environment.
# Compose does not pass arbitrary .env keys into app containers automatically.
# Use separate least-privilege credentials; do not reuse InfluxDB bootstrap admin tokens.
# ConnectionStrings__TelemetryControl=
# Queue__RabbitMq__Password=
# InfluxDb__Queryable__Url=http://influxdb:8181
# InfluxDb__Queryable__Database=telemetry
# InfluxDb__Queryable__Token=
# Worker: use a protected untracked .env.worker file for the Compose app profile.
# Processing__DiagnosticKey= (persistent Base64 key with at least 32 random bytes)
# Worker__Concurrency=4
# Worker__HeartbeatInterval=00:00:05
# Queue__RabbitMq__Prefetch=8
# Queue__RabbitMq__DrainTimeout=00:00:30
# Host-based runs must also override service endpoints to localhost and development ports.
# Explicit emulator use only (the default queue provider remains RabbitMq):
# Queue__Provider=PubSub
# Queue__PubSub__ProjectId=centralmobilidade-local
# Queue__PubSub__EmulatorHost=127.0.0.1:8085
# Authentication__Producers holds one internal producer credential shared by all companies;
# no producer company allowlist is required. Provision only hashed credentials, never raw tokens.
# Operator and viewer credentials, permissions and company scopes remain separate.
# One server (influxdb) and one terminating initializer (influxdb-init); no pending token file.
# Existing catalogs: preserve the original token file, project name and queryable volume/node-id.
# Run Compose explicitly; starting the solution in the IDE does not start these services.
# BatchInspection__CursorKey= (API: persistent Base64 key with exactly 32 random bytes; share across replicas)
# Retention__Interval=00:05:00
# Retention__PassTimeout=00:01:00
# Retention__PageSize=200
# Retention__MaxPages=20
