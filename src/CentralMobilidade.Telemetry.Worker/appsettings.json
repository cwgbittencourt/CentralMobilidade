{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Health": {
    "ProbeTimeout": "00:00:03",
    "WorkerMaxAge": "00:00:30"
  },
  "Observability": {
    "TraceSamplingRatio": 1,
    "OtlpTraceEndpoint": null,
    "WorkerMetricsUrl": "http://0.0.0.0:9464"
  },
  "ConnectionStrings": {
    "TelemetryControl": ""
  },
  "Worker": {
    "Concurrency": 4,
    "HeartbeatInterval": "00:00:05",
    "RecoveryDelay": "00:00:01"
  },
  "Processing": {
    "DiagnosticKey": "",
    "LeaseDuration": "00:05:00",
    "RenewalInterval": "00:00:30",
    "AttemptTimeout": "00:10:00"
  },
  "Retention": {
    "Interval": "00:05:00",
    "PassTimeout": "00:01:00",
    "PageSize": 200,
    "MaxPages": 20
  },
  "Telemetry": {
    "MaxCompressedBytes": 8388608,
    "MaxDecompressedBytes": 67108864,
    "MaxExpansionRatio": 100,
    "MaxLineBytes": 16384,
    "MaxLinesPerBatch": 50000,
    "UploadTimeout": "00:00:30",
    "QueueRetention": "7.00:00:00",
    "WriteBatchMaxPoints": 5000,
    "WriteBatchMaxBytes": 2097152,
    "WriteBatchFlushInterval": "00:00:01",
    "BatchStatusRetention": "30.00:00:00",
    "QuarantineRetention": "30.00:00:00",
    "FingerprintEvidenceRetention": "30.00:00:00",
    "LocalTelemetryRetention": "60.00:00:00",
    "Viewer": {
      "LatestPositionMaxVehicles": 500,
      "TripMaxDuration": "1.00:00:00",
      "TripMaxPoints": 10000,
      "HealthMaxDuration": "7.00:00:00",
      "HealthMinGranularity": "00:01:00",
      "HealthMaxPoints": 10000
    }
  },
  "Queue": {
    "Provider": "RabbitMq",
    "RabbitMq": {
      "Host": "rabbitmq",
      "Port": 5672,
      "VirtualHost": "telemetry",
      "Username": "telemetry",
      "Password": "",
      "Prefetch": 8,
      "MaxAttempts": 10,
      "RetryDelay": "00:00:01",
      "MaxRetryDelay": "00:01:00",
      "DrainTimeout": "00:00:30",
      "PublishTimeout": "00:00:05"
    },
    "PubSub": {
      "ProjectId": "",
      "TopicId": "telemetry-batches",
      "SubscriptionId": "telemetry-worker",
      "EmulatorHost": ""
    }
  },
  "InfluxDb": {
    "Queryable": {
      "Url": "http://influxdb:8181",
      "Database": "telemetry",
      "Token": ""
    }
  },
  "Quarantine": {
    "Path": "/quarantine/rejections"
  }
}
