{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Health": {
    "ProbeTimeout": "00:00:03",
    "WorkerMaxAge": "00:00:30",
    "WorkerHealthUrl": "http://worker:9464"
  },
  "Proxy": {
    "ForwardLimit": 1,
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Observability": {
    "TraceSamplingRatio": 1,
    "OtlpTraceEndpoint": null
  },
  "ConnectionStrings": {
    "TelemetryControl": ""
  },
  "Telemetry": {
    "MaxCompressedBytes": 8388608,
    "MaxDecompressedBytes": 67108864,
    "MaxExpansionRatio": 100,
    "MaxLineBytes": 16384,
    "MaxLinesPerBatch": 50000,
    "UploadTimeout": "00:00:30",
    "QueueRetention": "7.00:00:00",
    "WriteBatchMaxPoints": 5000,
    "WriteBatchMaxBytes": 2097152,
    "WriteBatchFlushInterval": "00:00:01",
    "BatchStatusRetention": "30.00:00:00",
    "QuarantineRetention": "30.00:00:00",
    "FingerprintEvidenceRetention": "30.00:00:00",
    "LocalTelemetryRetention": "60.00:00:00",
    "Viewer": {
      "LatestPositionMaxVehicles": 500,
      "TripMaxDuration": "1.00:00:00",
      "TripMaxPoints": 10000,
      "HealthMaxDuration": "7.00:00:00",
      "HealthMinGranularity": "00:01:00",
      "HealthMaxPoints": 10000
    }
  },
  "Queue": {
    "Provider": "RabbitMq",
    "RabbitMq": {
      "Host": "rabbitmq",
      "Port": 5672,
      "VirtualHost": "telemetry",
      "Username": "telemetry",
      "Password": ""
    },
    "PubSub": {
      "ProjectId": "",
      "TopicId": "telemetry-batches",
      "SubscriptionId": "telemetry-worker",
      "EmulatorHost": ""
    }
  },
  "InfluxDb": {
    "Queryable": {
      "Url": "http://influxdb:8181",
      "Database": "telemetry",
      "Token": ""
    }
  },
  "Quarantine": {
    "Path": "/quarantine/rejections"
  },
  "AllowedHosts": "localhost;127.0.0.1;api",
  "Authentication": {
    "Producers": [],
    "Operators": [],
    "ViewerServices": [],
    "Profiles": []
  }
}
