{
  "uid": "viewer-vehicle-trip",
  "title": "Trajetória de um veículo — Viewer",
  "description": "Pontos de um único veículo em ordem de evento (UTC). Selecione uma janela maior que zero e de até 24 horas; início incluído e fim excluído. Até 10.000 pontos iniciais; atingir o limite pode truncar a trajetória.",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "tags": [
    "mobilidade",
    "viewer",
    "telemetria"
  ],
  "timezone": "utc",
  "refresh": "",
  "time": {
    "to": "now",
    "from": "now-1h"
  },
  "timepicker": {
    "time_options": [
      5,
      15,
      30,
      60,
      180,
      360,
      720,
      1440
    ],
    "hidden": false,
    "refresh_intervals": [
      "30s",
      "1m",
      "5m"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "empresaId",
        "label": "Empresa",
        "type": "textbox",
        "query": "${VIEWER_COMPANY_ID}",
        "current": {
          "text": "${VIEWER_COMPANY_ID}",
          "value": "${VIEWER_COMPANY_ID}"
        },
        "hide": 0,
        "skipUrlSync": false
      },
      {
        "hide": 0,
        "query": "",
        "skipUrlSync": false,
        "type": "textbox",
        "label": "Veículo",
        "name": "vehicleId",
        "current": {
          "text": "",
          "value": ""
