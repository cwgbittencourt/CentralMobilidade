      },
      {
        "skipUrlSync": false,
        "hide": 0,
        "label": "Limite de pontos (1–10.000)",
        "name": "limit",
        "query": "10000",
        "type": "textbox",
        "current": {
          "text": "10000",
          "value": "10000"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Trajetória · ordem do evento · máximo 24 h / 10.000 pontos",
      "description": "Pontos de um único veículo em ordem de evento (UTC). Selecione uma janela maior que zero e de até 24 horas; início incluído e fim excluído. Até 10.000 pontos iniciais; atingir o limite pode truncar a trajetória. A API valida o período e o escopo; valores fora do limite retornam erro. Limites menores configurados na API também se aplicam.",
      "gridPos": {
        "h": 16,
        "w": 24,
        "x": 0,
        "y": 0
      },
