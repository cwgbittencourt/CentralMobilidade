        "type": "yesoreyeram-infinity-datasource",
        "uid": "${VIEWER_DATASOURCE_UID}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "${VIEWER_DATASOURCE_UID}"
          },
          "type": "json",
          "source": "url",
          "url": "/api/v1/presentation/telemetry/trips/${vehicleId:percentencode}?empresaId=${empresaId:percentencode}&fromUtc=${__from:date:iso}&toUtc=${__to:date:iso}&limit=${limit:percentencode}",
          "url_options": {
            "method": "GET"
          },
          "parser": "backend",
          "format": "table",
          "root_selector": "",
          "columns": [
            {
              "selector": "empresaId",
