        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "influxdb",
        "uid": "internal-influx"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "internal-influx"
          },
          "rawSql": "SELECT empresa_id AS \"empresaId\", veiculo_id AS \"vehicleId\", time AS \"eventTime\", latitude, longitude, velocidade AS speed, ignicao AS ignition FROM telemetria WHERE empresa_id = ${empresaId:sqlstring} AND veiculo_id = ${vehicleId:sqlstring} AND time >= to_timestamp_millis(${__from}) AND time < to_timestamp_millis(${__to}) AND ${__to} > ${__from} AND (${__to} - ${__from}) <= 86400000 ORDER BY time ASC LIMIT 10000",
          "rawQuery": true,
          "format": "table"
        }
      ],
