      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "internal-influx"
          },
          "rawSql": "SELECT empresa_id AS \"empresaId\", date_bin(INTERVAL '1 minute', time, to_timestamp_millis(${__from})) AS time, COUNT(*) AS \"storedPoints\" FROM telemetria WHERE empresa_id = ${empresaId:sqlstring} AND time >= to_timestamp_millis(${__from}) AND time < to_timestamp_millis(${__to}) AND ${__to} > ${__from} AND (${__to} - ${__from}) <= 604800000 GROUP BY empresa_id, 2 ORDER BY time ASC LIMIT 10000",
          "rawQuery": true,
          "format": "table"
        }
      ],
