      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "internal-influx"
          },
          "rawSql": "SELECT empresa_id AS \"empresaId\", veiculo_id AS \"vehicleId\", time AS \"eventTime\", latitude, longitude, velocidade AS speed, ignicao AS ignition FROM (SELECT time, empresa_id, veiculo_id, latitude, longitude, velocidade, ignicao, ROW_NUMBER() OVER (PARTITION BY empresa_id, veiculo_id ORDER BY time DESC) AS position_rank FROM telemetria WHERE empresa_id = ${empresaId:sqlstring}) WHERE position_rank = 1 ORDER BY veiculo_id ASC LIMIT 500",
          "rawQuery": true,
          "format": "table"
        }
      ],
